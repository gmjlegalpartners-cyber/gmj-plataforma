{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "clientes.gmj-abogados.com.ar" }],
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ]
}
